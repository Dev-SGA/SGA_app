# Required in production (Vercel → Settings → Environment Variables)
SESSION_SECRET=replace-with-long-random-string-min-16-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password

# Neon / Postgres (Vercel Storage → Neon). If unset, local dev uses data/athletes.json
# Required on Vercel (filesystem is read-only). Use Vercel → Storage → Neon, or paste a Neon connection string.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Optional: direct URL for schema setup (Vercel Neon integration sets this automatically)
# DATABASE_URL_UNPOOLED=
